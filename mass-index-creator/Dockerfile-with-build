FROM eclipse-temurin:25-jdk-noble AS builder

USER root

RUN apt-get update && apt-get install -y --no-install-recommends findutils && rm -rf /var/lib/apt/lists/*

ADD ./ /usr/share/sources

WORKDIR /usr/share/sources

RUN chmod +x ./gradlew && ./gradlew :mass-index-creator:build -x test

FROM eclipse-temurin:25-jdk-noble

WORKDIR /opt/app

COPY --from=builder /usr/share/sources/mass-index-creator/build/libs/mass-index-creator-0.0.1-SNAPSHOT.jar app.jar

USER root

RUN groupadd --gid 1001 javauser && useradd --uid 1001 --gid 1001 -m javauser

RUN chown -R javauser:javauser .

USER javauser

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=85", "-XX:MinRAMPercentage=85", "-jar", "/opt/app/app.jar"]
